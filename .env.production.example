# ============================================================
# Agri Clinic — AWS EC2 production (.env)
# Copy to the server as:
#   /var/www/agri-backend/agri-clinic-backend/.env
# NEVER commit real .env to version control.
# Canonical DB source: this file (loaded by Django / systemd EnvironmentFile).
# ============================================================

APP_ENV=production

# ------ Core Django ------
SECRET_KEY=replace-with-long-random-secret
DEBUG=False
LOG_LEVEL=INFO
ALLOWED_HOSTS=YOUR_EC2_PUBLIC_IP,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com
# Keep false until TLS certificates are confirmed on Nginx; then set true.
SECURE_SSL_REDIRECT=false

# ------ CORS ------
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ------ Database (PostgreSQL on same EC2 — preferred) ------
# Option A — single URL (no SSL for localhost):
# DATABASE_URL=postgresql://agri_user:CHANGE_ME@127.0.0.1:5432/agri_clinic_db

# Option B — individual components:
DB_NAME=agri_clinic_db
DB_USER=agri_user
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL_REQUIRE=false

# Do NOT set DATABASE_URL to any *.render.com / dpg-* host.

# ------ Static / media on EC2 (persistent; survives git deploy) ------
STATIC_ROOT=/var/www/agri-backend/agri-clinic-backend/staticfiles
MEDIA_ROOT=/var/www/agri-backend/media
MEDIA_URL=/media/

# ------ Redis (optional) ------
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ------ Object storage (optional; leave false for EC2 disk media) ------
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
