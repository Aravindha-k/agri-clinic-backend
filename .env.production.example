# ============================================================
# Agri Clinic — AWS EC2 production (.env)
# Copy to the server as .env (e.g. /opt/agri-clinic/.env)
# NEVER commit real .env to version control.
# ============================================================

APP_ENV=production

# ------ Core Django ------
SECRET_KEY=replace-with-long-random-secret
DEBUG=False
LOG_LEVEL=INFO
ALLOWED_HOSTS=your-ec2-public-ip,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com
SECURE_SSL_REDIRECT=false

# ------ CORS ------
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ------ Database (PostgreSQL on same EC2) ------
# Option A — single URL:
# DATABASE_URL=postgresql://agri_user:kavyaagri@127.0.0.1:5432/agri_clinic_db

# Option B — individual components:
DB_NAME=agri_clinic_db
DB_USER=agri_user
DB_PASSWORD=kavyaagri
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL_REQUIRE=false

# ------ Static / media on EC2 ------
STATIC_ROOT=/opt/agri-clinic/staticfiles
MEDIA_ROOT=/opt/agri-clinic/media

# ------ Redis (optional) ------
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ------ Media storage (optional S3) ------
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
