# ============================================================
# Agri Clinic — Local development (.env)
# Copy:  cp .env.local.example .env
# NEVER commit .env to version control.
# ============================================================

APP_ENV=local

# ------ Core Django ------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
LOG_LEVEL=INFO

# Hostnames only (no http://, no :8000). Replace YOUR_LAN_IP after `ipconfig` / `ip addr` / `ifconfig`.
# See LOCAL_NETWORK_CONFIGURATION.md
ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_LAN_IP
# Or keep ALLOWED_HOSTS minimal and append:
# EXTRA_ALLOWED_HOSTS=YOUR_LAN_IP

CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://YOUR_LAN_IP:8000
# EXTRA_CSRF_TRUSTED_ORIGINS=http://YOUR_LAN_IP:8000

# ------ CORS ------
# Local default: allow all (admin Vite SPA). Production must set false + explicit origins.
# Mobile JWT API calls do not rely on browser CORS.
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------ Database (local PostgreSQL) ------
# Option A — single URL (recommended):
DATABASE_URL=postgresql://postgres:admin123@127.0.0.1:5432/agri_clinic_db

# Option B — individual components (used when DATABASE_URL is empty):
# DB_NAME=agri_clinic_db
# DB_USER=postgres
# DB_PASSWORD=admin123
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSL_REQUIRE=false

# ------ Static / media (defaults: ./staticfiles and ./media) ------
# STATIC_ROOT=staticfiles
# MEDIA_ROOT=media

# ------ Redis (optional) ------
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ------ Media storage ------
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
