# ============================================================
# Agri Clinic — Environment templates
# NEVER commit .env to version control.
# ============================================================
#
# Local development:
#   cp .env.local.example .env
#   Then replace YOUR_LAN_IP (see LOCAL_NETWORK_CONFIGURATION.md)
#
# AWS EC2 production:
#   cp .env.production.example .env
#
# Required for physical Android testing over Wi-Fi:
#   ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_LAN_IP
#   CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://YOUR_LAN_IP:8000
#
# See also:
#   .env.local.example
#   .env.production.example
#   LOCAL_NETWORK_CONFIGURATION.md
# ============================================================
