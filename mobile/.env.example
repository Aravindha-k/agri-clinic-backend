# Kavya Agri Clinic — mobile environment (copy to `.env` in this folder)
# NEVER commit `.env` with real hostnames that contain secrets.
# Restart Expo (`npx expo start -c`) after changing these values.

# local | staging | production
EXPO_PUBLIC_APP_ENV=local

# API root including /api/v1 (no trailing slash)
#
# Setup A — Physical Android phone + PC backend on same Wi-Fi:
#   EXPO_PUBLIC_API_BASE=http://192.168.x.x:8000/api/v1
#
# Setup B — Android emulator + PC backend:
#   EXPO_PUBLIC_API_BASE=http://10.0.2.2:8000/api/v1
#
# Setup C — Staging (HTTPS required):
#   EXPO_PUBLIC_API_BASE=https://your-staging-host.example.com/api/v1
#   EXPO_PUBLIC_APP_ENV=staging
#
EXPO_PUBLIC_API_BASE=http://10.0.2.2:8000/api/v1

# Allow HTTP cleartext on Android for local LAN only (ignored when APP_ENV is staging/production).
# Set true when using http:// LAN IP on a physical device with a custom/dev client.
# Expo Go on many devices already permits cleartext to private IPs; keep this for clarity.
EXPO_PUBLIC_ALLOW_CLEARTEXT=true
